# Neon Postgres. DATABASE_URL is the pooled (-pooler) connection string, used
# by the running app (serverless/connection-per-request traffic).
# DATABASE_URL_UNPOOLED is the direct connection string, used only for schema
# migrations (scripts/db-migrate.ts) - Neon's pooled connections run through
# PgBouncer in transaction mode, which doesn't reliably support session-level
# DDL/transaction semantics.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Admin dashboard auth. Generate ADMIN_PASSWORD_HASH with bcrypt (e.g.
# `node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"`)
# - never commit the plaintext password. ADMIN_SESSION_SECRET should be a
# long random string (e.g. `openssl rand -hex 32`), used to sign session
# cookies so they can't be forged.
# IMPORTANT: escape every literal $ in the bcrypt hash as \$ - Next.js's env
# loader otherwise treats $2b, $12, etc. as variable references and silently
# strips them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$<rest-of-bcrypt-hash>
ADMIN_SESSION_SECRET=<random-hex-string>

# Cashflows Hosted Checkout Pages. Get these from Cashflows Portal > API Data
# (or your merchant activation email). Use the integration/sandbox
# Configuration ID + API key for local dev and CASHFLOWS_BASE_URL set to
# https://gateway-int.cashflows.com - only use the production values and
# https://gateway.cashflows.com once you're ready to take real payments.
CASHFLOWS_CONFIGURATION_ID=<configuration-id>
CASHFLOWS_API_KEY=<api-key>
CASHFLOWS_BASE_URL=https://gateway-int.cashflows.com

# Resend (transactional emails sent to customers when an order's status
# changes). RESEND_FROM_EMAIL must be an address on a domain verified in
# your Resend account, or sends will fail/be rejected.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Grasshopper Fuels <orders@grasshopperfuels.com>
