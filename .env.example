# AWS IAM role that Vercel exchanges its OIDC token for, via STS AssumeRoleWithWebIdentity.
AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# Region of the Aurora/RDS PostgreSQL cluster.
AWS_REGION=eu-west-2

# Aurora/RDS cluster endpoint, port, IAM database user, and database name.
# No password is stored anywhere - RDS IAM auth tokens are minted per connection.
DB_HOST=your-cluster.cluster-xxxxxxxxxx.eu-west-2.rds.amazonaws.com
DB_PORT=5432
DB_USER=grasshopper_app
DB_NAME=postgres

# Admin dashboard auth. Generate ADMIN_PASSWORD_HASH with bcrypt (e.g.
# `node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"`)
# - never commit the plaintext password. ADMIN_SESSION_SECRET should be a
# long random string (e.g. `openssl rand -hex 32`), used to sign session
# cookies so they can't be forged.
# IMPORTANT: escape every literal $ in the bcrypt hash as \$ - Next.js's env
# loader otherwise treats $2b, $12, etc. as variable references and silently
# strips them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$<rest-of-bcrypt-hash>
ADMIN_SESSION_SECRET=<random-hex-string>

# Required for local dev only, so @vercel/oidc-aws-credentials-provider has a
# token to exchange. Run `vercel link` && `vercel env pull` to populate it,
# or use `vercel dev` instead of `next dev`.
# VERCEL_OIDC_TOKEN=
